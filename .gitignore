# ══════════════════════════════════════════════════════════════════
#  .gitignore — Quora Duplicate Detection Project
#  Week 1 → Week 2 → Week 3 NLP Pipeline
# ══════════════════════════════════════════════════════════════════
.git-rewrite/

# ── DATA FILES (too large for GitHub, regenerated by notebooks) ───
*.csv
*.parquet
*.tsv
*.json
*.jsonl
*.png

# Keep sample/test data if you have any small reference files
# !sample_data.csv


# ── MODEL FILES (large binaries) ──────────────────────────────────
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.bin
*.h5
*.hdf5
*.model
*.vec

# Word2Vec / Gensim saved models
*.wv
*.kv
/models/
/saved_models/
/checkpoints/
models/


# ── NOTEBOOK OUTPUT (cell outputs bloat file size) ────────────────
# Push clean notebooks — outputs are reproducible by running cells
# Tip: use nbstripout to auto-strip on every commit
# Install: pip install nbstripout && nbstripout --install


# ── PYTHON CACHE ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/


# ── VIRTUAL ENVIRONMENT ───────────────────────────────────────────
venv/
env/
.env/
.venv/
ENV/
myenv/


# ── ENVIRONMENT VARIABLES (never push secrets/API keys) ───────────
.env
.env.local
.env.production
*.env
secrets.py
config_local.py


# ── HUGGINGFACE CACHE (auto-downloaded, no need to push) ──────────
~/.cache/huggingface/
.cache/
/cache/
huggingface_cache/


# ── JUPYTER NOTEBOOK ARTIFACTS ────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py


# ── MATPLOTLIB / PLOT OUTPUT ──────────────────────────────────────
# PNGs are regenerated when notebooks run — don't push them
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# EXCEPTION: keep results folder plots
!results/
!results/*.png
!results/*.csv
!results/*.jpg

# EXCEPTION: keep any images that are part of README or docs
# !docs/images/*.png
# !README_assets/*.png


# ── OS JUNK ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini


# ── IDE / EDITOR FILES ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.spyproject/
.spyderproject/


# ── LOGS & TEMP FILES ─────────────────────────────────────────────
*.log
*.tmp
*.temp
/logs/
/tmp/


*.safetensors