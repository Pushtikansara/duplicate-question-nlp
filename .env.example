# ARES API Configuration
ARES_HOST=0.0.0.0
ARES_PORT=8000
ARES_WORKERS=4
ARES_LOG_LEVEL=info
ARES_DEBUG=false

# Security
ARES_SECRET_KEY=generate-a-random-secret-key-here
ARES_JWT_ALGORITHM=HS256
ARES_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ARES_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
ARES_RATE_LIMIT_ENABLED=true
ARES_RATE_LIMIT_REQUESTS=100
ARES_RATE_LIMIT_WINDOW_SECONDS=60

# CORS
ARES_CORS_ORIGINS=["*"]

# gRPC
ARES_GRPC_HOST=0.0.0.0
ARES_GRPC_PORT=50051

# Observability
ARES_OTEL_ENDPOINT=
ARES_PROMETHEUS_ENABLED=true
ARES_OTEL_SERVICE_NAME=ares-api

# Model
ARES_DEFAULT_MODEL=Week 4 Improved DistilBERT
ARES_DEFAULT_THRESHOLD=0.5
ARES_ENABLE_REFLECTION=true

# Storage
ARES_UPLOAD_DIR=/tmp/ares/uploads
