# Duplicate Question Detection - Environment Configuration
# Copy to .env and customize.
# Prefix: DQD_

# Environment (development / testing / production)
DQD_ENV=development

# Path overrides
# DQD_PROJECT_ROOT=/absolute/path/to/project
# DQD_DATA_DIR=/custom/data/path
# DQD_MODELS_DIR=/custom/models/path
# DQD_OUTPUTS_DIR=/custom/outputs/path

# Config directory override (default: configs/)
# DQD_CONFIG_DIR=/custom/config/path

# Device override
# DQD_DEVICE=cuda

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DQD_LOG_LEVEL=DEBUG

# Default model
# DQD_DEFAULT_MODEL="Improved DistilBERT (Week 4)"
